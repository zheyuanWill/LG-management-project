# ═══════════════════════════════════════════════════════════════════════════
# LG 船舶管理 ERP · 生产环境变量模板
# 复制为项目根目录的 .env 后使用（bootstrap.sh 会自动复制并补全密钥）。
#
# 占位符说明:
#   __GENERATE__  -> bootstrap.sh 会生成强随机值替换
#   __AUTO__      -> bootstrap.sh 会自动探测 ECS 公网 IP 填入
# ═══════════════════════════════════════════════════════════════════════════

# ── 数据库 ──────────────────────────────────────
PG_USER=lgadmin
PG_PASSWORD=__GENERATE__
PG_DATABASE=lg_erp

# ── MinIO 对象存储 ──────────────────────────────
MINIO_USER=minioadmin
MINIO_PASSWORD=__GENERATE__
MINIO_BUCKET=lg-erp
# 浏览器访问 MinIO 的外部地址（预签名 URL 用）。留 __AUTO__ 让脚本填 ECS 公网 IP
MINIO_PUBLIC_ENDPOINT=__AUTO__

# ── JWT 认证 ─────────────────────────────────────
JWT_SECRET_KEY=__GENERATE__

# ── 站点地址 ─────────────────────────────────────
# :80 = 仅 http（用 IP 访问，备案前）；改成你的域名 = 自动 HTTPS
SITE_ADDRESS=:80

# ── AI 服务 ─────────────────────────────────────
# mock = 不依赖外部大模型，系统可正常运行（AI 报告/对话不可用）
# cloud = 云端大模型（填下面三项）；ollama = 本机 Ollama
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_MODEL=deepseek-chat
LLM_API_KEY=
# 向量嵌入模型（本地 fastembed，离线可用）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ── 构建镜像源（国内加速） ───────────────────────
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn
NPM_REGISTRY=https://registry.npmmirror.com
